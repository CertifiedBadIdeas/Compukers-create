{
  "multipart": [
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "create:block/mechanical_pump/block",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "x": 180,
        "model": "compukters_create:block/pump_controller"
      }
    },
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "create:block/mechanical_pump/block"
      }
    },
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "compukters_create:block/pump_controller"
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "create:block/mechanical_pump/block",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "x": 90,
        "model": "compukters_create:block/pump_controller"
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "create:block/mechanical_pump/block",
        "x": 90,
