{
  "multipart": [
    {
      "when": {
        "axis": "y",
        "powered": "false"
      },
      "apply": {
        "model": "create:block/clutch/block"
      }
    },
    {
      "when": {
        "axis": "y",
        "powered": "false"
      },
      "apply": {
        "model": "compukters_create:block/clutch_controller_closed"
      }
    },
    {
      "when": {
        "axis": "y",
        "powered": "true"
      },
      "apply": {
        "model": "create:block/clutch/block_powered"
      }
    },
    {
      "when": {
        "axis": "y",
        "powered": "true"
      },
      "apply": {
        "model": "compukters_create:block/clutch_controller_open"
      }
    },
    {
      "when": {
        "axis": "z",
        "powered": "false"
      },
      "apply": {
        "model": "create:block/clutch/block",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "axis": "z",
        "powered": "false"
      },
      "apply": {
        "x": 90,
        "y": 180,
        "model": "compukters_create:block/clutch_controller_closed"
      }
    },
    {
      "when": {
        "axis": "z",
        "powered": "true"
      },
      "apply": {
        "model": "create:block/clutch/block_powered",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "axis": "z",
        "powered": "true"
      },
      "apply": {
        "x": 90,
        "y": 180,
        "model": "compukters_create:block/clutch_controller_open"
      }
    },
    {
      "when": {
        "axis": "x",
        "powered": "false"
      },
      "apply": {
        "model": "create:block/clutch/block",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "powered": "false"
      },
      "apply": {
        "x": 90,
        "y": 90,
        "model": "compukters_create:block/clutch_controller_closed"
      }
    },
    {
      "when": {
        "axis": "x",
        "powered": "true"
      },
      "apply": {
        "model": "create:block/clutch/block_powered",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "powered": "true"
      },
      "apply": {
        "x": 90,
        "y": 90,
        "model": "compukters_create:block/clutch_controller_open"
      }
    }
  ]
}
